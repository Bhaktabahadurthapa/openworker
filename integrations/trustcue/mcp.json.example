{
  "mcpServers": {
    "churncue": {
      "type": "streamable-http",
      "url": "http://localhost:8000/mcp",
      "enabled": true,
      "include_tools": [
        "health_check",
        "load_demo_dataset",
        "profile_dataset",
        "train_models",
        "score_customers",
        "compare_weekly_risk",
        "explain_risk",
        "generate_rescue_report"
      ],
      "requires_approval": false
    }
  }
}
